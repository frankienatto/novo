# ==============================================================================
# SYNAPSE HOSPITALITY — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Preencha as variáveis correspondentes no seu ambiente de produção ou CI/CD.
# NUNCA comite credenciais, segredos ou tokens reais neste arquivo.

# Server & Runtime
NODE_ENV=production
PORT=3000

# Firebase / GCP Configuration
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# One-time server-side STAGING bootstrap. Keep disabled except for the
# controlled first provisioning request; the UID is an identifier, not a secret.
STAGING_BOOTSTRAP_ENABLED=false
STAGING_BOOTSTRAP_UID=

# Explicit, temporary server-only binding of Firebase accounts created manually
# for a staging tenant. Keep disabled except during authorised provisioning.
STAGING_IDENTITY_PROVISIONING_ENABLED=false
STAGING_IDENTITY_PROVISIONING_ORGANIZATION_ID=
# Non-secret coordinates for the one-click staging-only identity tool.
STAGING_TEST_STAFF_UID=
STAGING_TEST_STAFF_EMAIL=
STAGING_TEST_STAFF_NAME=
STAGING_TEST_GUEST_UID=
STAGING_TEST_GUEST_EMAIL=
STAGING_TEST_GUEST_NAME=
STAGING_TEST_GUEST_PHONE=

# Firebase Web public configuration (injected only at frontend build time; never server secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# Core Security & Authentication
JWT_SECRET=
N8N_SECRET=
N8N_ORGANIZATION_ID=
N8N_PROPERTY_ID=

# AI (Google Gemini) Configuration
# Chave da API do Google Gemini (obrigatória para agentes autônomos e copilot)
GEMINI_API_KEY=

# Property Management System (PMS) — Aloha & Beds24
ALOHA_API_KEY=
ALOHA_PRO_WEBHOOK_SECRET=
VITE_BEDS24_PROPERTY_ID=
# Beds24 token is server-only. The frontend must never receive a token.
BEDS24_API_TOKEN=

# Google Calendar OAuth (server-side only; integration is configurable but not active without these)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Marketing & Ads Integrations
GOOGLE_ADS_API_KEY=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# Payments — optional server-side capabilities. The core starts without them;
# each unconfigured provider rejects requests fail-closed.
PAYMENTS_PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
VITE_MERCADOPAGO_PUBLIC_KEY=
PICPAY_CLIENT_ID=
PICPAY_CLIENT_SECRET=
PICPAY_WEBHOOK_TOKEN=
# Override only when PicPay documents a non-default staging endpoint.
PICPAY_PIX_API_BASE_URL=

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_CACHE=true
ENABLE_RATE_LIMIT=true
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true
