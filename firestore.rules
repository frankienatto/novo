rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Default Deny Catch-All ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Only an already-provisioned administrator may manage staff records.
    // A signed-in user must never bootstrap their own staff profile.
    function isTenantAdmin() {
      return isStaff() && staffDoc().role in ['Admin', 'Super Administrador', 'owner'];
    }

    // Checks if staff member belongs to the tenant of the document being read/updated/deleted
    function isStaffOfTenant(resData) {
      return isStaff() && (
        !('organizationId' in resData) ||
        !('organizationId' in staffDoc()) ||
        staffDoc().organizationId == resData.organizationId
      );
    }

    // Validates tenant field existence and matching on creation
    function isAllowedTenantCreate() {
      return isStaff()
          && ('organizationId' in request.resource.data)
          && (!('organizationId' in staffDoc()) || staffDoc().organizationId == request.resource.data.organizationId)
          && (!('propertyId' in staffDoc()) || !('propertyId' in request.resource.data) || staffDoc().propertyId == request.resource.data.propertyId);
    }

    // Ensures tenant and property scope immutability on updates
    function isTenantMatch() {
      return (!('organizationId' in request.resource.data) || !('organizationId' in resource.data) || request.resource.data.organizationId == resource.data.organizationId)
          && (!('propertyId' in request.resource.data) || !('propertyId' in resource.data) || request.resource.data.propertyId == resource.data.propertyId);
    }

    // Financial facts are written only by trusted server-side integrations.
    // A guest may retain access to their booking's non-financial profile data,
    // but may never turn a booking into payment evidence from the browser.
    function financialFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus', 'balance', 'totalPrice', 'amountPaid', 'paid',
        'currency', 'paymentIntentId', 'stripePaymentIntentId'
      ]);
    }

    function isNonFinancialLegacyBookingCreate() {
      return !request.resource.data.keys().hasAny([
        'paymentStatus', 'balance', 'totalPrice', 'amountPaid', 'paid',
        'currency', 'paymentIntentId', 'stripePaymentIntentId'
      ]);
    }

    // Roles, permissions and tenant scope are admin-owned. A staff member may
    // maintain only their own non-authorisation profile fields.
    function isSafeSelfStaffProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'email', 'phone', 'avatarUrl', 'photoURL', 'updatedAt']);
    }

    // --- Connectivity Test Collection ---
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }

    // --- Core User & Identity Collections ---
    match /staff/{staffId} {
      allow read: if isSignedIn() && (request.auth.uid == staffId || isStaffOfTenant(resource.data));
      allow create: if isTenantAdmin()
          && staffId != request.auth.uid
          && isAllowedTenantCreate();
      allow update: if isTenantAdmin() && isStaffOfTenant(resource.data) && isTenantMatch()
          || (isSignedIn() && request.auth.uid == staffId && isSafeSelfStaffProfileUpdate());
      allow delete: if isTenantAdmin() && isStaffOfTenant(resource.data);
    }

    match /guests/{guestId} {
      allow read: if isSignedIn() && (request.auth.uid == guestId || isStaffOfTenant(resource.data));
      allow create: if isSignedIn() && (request.auth.uid == guestId || isAllowedTenantCreate());
      allow update: if isSignedIn() && (request.auth.uid == guestId || isStaffOfTenant(resource.data)) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    // --- Booking & User Transactional Data ---
    match /bookings/{bookingId} {
      allow read: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow create: if isSignedIn() && ('organizationId' in request.resource.data) && isNonFinancialLegacyBookingCreate() && (isAllowedTenantCreate() || request.resource.data.guestId == request.auth.uid || request.resource.data.email == request.auth.token.email);
      allow update: if (isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.email == request.auth.token.email))) && isTenantMatch() && financialFieldsUnchanged();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /notifications/{notificationId} {
      allow read: if isStaffOfTenant(resource.data) || (isSignedIn() && resource.data.guestId == request.auth.uid);
      allow create: if isSignedIn() && ('organizationId' in request.resource.data) && (isAllowedTenantCreate() || request.resource.data.guestId == request.auth.uid);
      allow update: if (isStaffOfTenant(resource.data) || (isSignedIn() && resource.data.guestId == request.auth.uid)) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data) || (isSignedIn() && resource.data.guestId == request.auth.uid);
    }

    match /guestStories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && ('organizationId' in request.resource.data) && (isAllowedTenantCreate() || request.resource.data.guestId == request.auth.uid);
      allow update: if (isStaffOfTenant(resource.data) || (isSignedIn() && resource.data.guestId == request.auth.uid)) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data) || (isSignedIn() && resource.data.guestId == request.auth.uid);
    }

    // --- Staff-Only Operational Collections ---
    match /tasks/{taskId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /transactions/{transactionId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /expenses/{expenseId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /projects/{projectId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /shoppingLists/{listId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /tables/{tableId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /adCampaigns/{campaignId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /emailTemplates/{templateId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /integrationSettings/{settingId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /integrationSyncLogs/{logId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /integrationBillingMappings/{mappingId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /externalApiKeys/{keyId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /scheduledPosts/{postId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /blocks/{blockId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /customAudiences/{audienceId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /socialConnections/{connId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /platformConnections/{connId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /serviceBookings/{bookingId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /deliveryOrders/{orderId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    match /coworkingDesks/{deskId} {
      allow read, delete: if isStaffOfTenant(resource.data);
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
    }

    // --- Public / Portal Data (Read: Public/Guest; Write: Staff of Tenant) ---
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /themeSettings/{settingId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /propertyEvents/{eventId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /localGuideTips/{tipId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /addOns/{addOnId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /loyaltyLevels/{levelId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /achievements/{achId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /promoCodes/{codeId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /packageDeals/{dealId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /partnerServices/{serviceId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /amenities/{amenityId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /digitalMenu/{menuId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /sharedSpaces/{spaceId} {
      allow read: if true;
      allow create: if isAllowedTenantCreate();
      allow update: if isStaffOfTenant(resource.data) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    // --- Interactive Guest / Community Collections ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.guestId == request.auth.uid));
    }

    match /guestPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.guestId == request.auth.uid));
    }

    match /guestActivities/{activityId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.guestId == request.auth.uid));
    }

    match /activityParticipants/{partId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    match /activityComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.guestId == request.auth.uid));
    }

    match /activityContributions/{contribId} {
      allow read: if true;
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update, delete: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.guestId == request.auth.uid));
    }

    match /chatConversations/{chatId} {
      allow read: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update: if (isStaffOfTenant(resource.data) || isSignedIn()) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /chatMessages/{msgId} {
      allow read: if isStaffOfTenant(resource.data) || (isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.senderId == request.auth.uid));
      allow create: if isSignedIn() && ('organizationId' in request.resource.data);
      allow update: if (isStaffOfTenant(resource.data) || isSignedIn()) && isTenantMatch();
      allow delete: if isStaffOfTenant(resource.data);
    }

    match /synapse_hospitality/{datasetId} {
      allow read, write: if isStaffOfTenant(resource.data);
    }

    // Integrações e índices de ocupação são exclusivamente administrados pelo
    // backend. Clientes nunca criam feeds, identidades externas ou locks.
    match /icalFeeds/{document=**} { allow read, write: if false; }
    match /icalExternalEvents/{document=**} { allow read, write: if false; }
    match /icalSyncRuns/{document=**} { allow read, write: if false; }
    match /calendarSyncConflicts/{document=**} { allow read, write: if false; }
    match /occupancyLocks/{document=**} { allow read, write: if false; }
    match /icalSyncLocks/{document=**} { allow read, write: if false; }
    match /aiRuns/{document=**} { allow read, write: if false; }
    match /checkoutCapabilities/{document=**} { allow read, write: if false; }
    match /publicReservationIdempotency/{document=**} { allow read, write: if false; }
    match /paymentRecords/{document=**} { allow read, write: if false; }
    match /stripeEvents/{document=**} { allow read, write: if false; }
    match /paymentWebhookEvents/{document=**} { allow read, write: if false; }
  }
}


