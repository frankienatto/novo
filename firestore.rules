rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções operacionais do sistema PMS e PDV (Mesas, Reservas, Quartos, Produtos, etc)
    match /tables/{tableId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /guests/{guestId} {
      allow read, write: if true;
    }
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /deliveryOrders/{orderId} {
      allow read, write: if true;
    }
    match /coworkingDesks/{deskId} {
      allow read, write: if true;
    }
    match /integrationSyncLogs/{logId} {
      allow read, write: if true;
    }

    // Acesso geral para todas as coleções operacionais e sincronizações da aplicação
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
